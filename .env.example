# Copy to .env.local (not committed) and fill in from Supabase:
# Dashboard → Project Settings → API Keys (Project URL and the Publishable key).
# Without them the app runs locally only, as before.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
